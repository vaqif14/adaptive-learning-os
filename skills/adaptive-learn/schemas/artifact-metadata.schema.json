{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactMetadata",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifier_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tests_run": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tests_passed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "lint_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

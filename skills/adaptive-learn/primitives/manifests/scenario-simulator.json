    "time_pressure_sec": {"type": ["integer", "null"], "minimum": 1},
    "evaluation_contract": {"type": "object"}
  },
  "supported_events": [
    "scenario_started",
    "prompt_presented",
    "learner_response_committed",
    "feedback_recorded",
    "scenario_completed"
  ]
